@page "/leave-management"
@using Leavio.DbModels
@using Leavio.Models
@using Leavio.PanelService
@using Blazored.SessionStorage
@inject AdminPanelService adminPanelService
@inject ISessionStorageService sessionStorage

<PageTitle>Leave Management</PageTitle>

@if (isLoading)
{
    <div class="lm-loading">Loading leave management...</div>
}
else if (!isAuthorized)
{
    <div class="lm-unauthorized">
        <h2>Access Denied</h2>
        <p>Admin role is required to configure leave types and employment rules.</p>
        <a href="/">Return to Home</a>
    </div>
}
else
{
    <div class="lm-page">
        <div class="lm-header">
            <h1>Leave Management</h1>
            <p>Define employment categories, leave types, and how many days each employment group receives per leave type.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(alertMessage))
        {
            <div class="lm-alert @(isSuccess ? "lm-alert-success" : "lm-alert-error")">@alertMessage</div>
        }

        <section class="lm-section">
            <div class="lm-section-head">
                <h2>Employment types</h2>
                <div class="lm-section-actions">
                    <button type="button" class="lm-btn lm-btn-secondary" @onclick="AddEmploymentTypeRow" disabled="@isSavingEmployment">Add type</button>
                    <button type="button" class="lm-btn lm-btn-primary" @onclick="SaveEmploymentTypes" disabled="@isSavingEmployment">
                        @(isSavingEmployment ? "Saving..." : "Save employment types")
                    </button>
                </div>
            </div>
            <div class="lm-table-wrap">
                <table class="lm-table lm-table-compact">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Order</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in employmentTypeRows)
                        {
                            <tr>
                                <td><input class="lm-input" type="text" @bind="row.Name" @bind:event="oninput" maxlength="100" disabled="@isSavingEmployment" /></td>
                                <td><input class="lm-input lm-input-order" type="number" step="1" @bind="row.DisplayOrder" disabled="@isSavingEmployment" /></td>
                                <td class="lm-center"><input type="checkbox" @bind="row.IsActive" disabled="@isSavingEmployment" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="lm-hint">New types appear in the list below and on the Employee Info page. After adding a type, set days per leave type in the next section.</p>
        </section>

        <section class="lm-section">
            <div class="lm-section-head">
                <h2>Leave types &amp; allocations by employment</h2>
                <div class="lm-section-actions">
                    <button type="button" class="lm-btn lm-btn-primary" @onclick="OpenAddForm" disabled="@isSavingTypes">Add</button>
                </div>
            </div>
            <p class="lm-sub">Each row is one employment category paired with a leave type. Use Add or Edit to change days and options.</p>

            @if (showLeaveForm)
            {
                <div class="lm-form-panel">
                    <div class="lm-form-card">
                        <div class="lm-form-card-head">
                            <h3 class="lm-form-title">@(leaveFormIsEdit ? "Edit allocation" : "Add allocation")</h3>
                            <button type="button" class="lm-form-dismiss" @onclick="CloseLeaveForm" disabled="@isSavingTypes" aria-label="Close form">&times;</button>
                        </div>
                        <div class="lm-form-grid">
                            @if (leaveFormIsEdit)
                            {
                                <div class="lm-form-cell">
                                    <span class="lm-form-label">Employee type</span>
                                    <div class="lm-form-static">@modalEtName</div>
                                </div>
                                <div class="lm-form-cell">
                                    <span class="lm-form-label">Leave type</span>
                                    <div class="lm-form-static">@modalLtName</div>
                                </div>
                            }
                            else
                            {
                                <div class="lm-form-cell">
                                    <label class="lm-form-label" for="lm-et">Employee type</label>
                                    <select id="lm-et" class="lm-form-control lm-select-block" @bind="modalEtIdBind">
                                        <option value="0">Select…</option>
                                        @foreach (var et in employmentTypeRows.Where(e => e.Id > 0).OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name))
                                        {
                                            <option value="@et.Id">@et.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="lm-form-cell">
                                    <label class="lm-form-label" for="lm-lt">Leave type</label>
                                    <select id="lm-lt" class="lm-form-control lm-select-block" @bind="modalLtChoiceBind" disabled="@(modalEtId <= 0)">
                                        <option value="0">Select…</option>
                                        @foreach (var lt in leaveTypeRows.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name))
                                        {
                                            <option value="@lt.Id">@lt.Name</option>
                                        }
                                        <option value="-1">New leave type…</option>
                                    </select>
                                </div>
                                @if (ShowAddNewLeaveName)
                                {
                                    <div class="lm-form-cell lm-form-span-2">
                                        <label class="lm-form-label" for="lm-lt-new">New leave type name</label>
                                        <input id="lm-lt-new" class="lm-form-control" type="text" maxlength="100" @bind="modalNewLeaveName" @bind:event="oninput" placeholder="e.g. Maternity Leave" />
                                    </div>
                                }
                            }

                            <div class="lm-form-cell">
                                <label class="lm-form-label" for="lm-days">Days</label>
                                <input id="lm-days" class="lm-form-control" type="number" step="0.01" min="0" @bind="modalDays" />
                            </div>
                            <div class="lm-form-cell lm-form-cell-check">
                                <span class="lm-form-label">Document</span>
                                <label class="lm-form-switch">
                                    <input type="checkbox" @bind="modalDoc" />
                                    <span>Require document for multi-day leave</span>
                                </label>
                            </div>

                            <div class="lm-form-cell lm-form-cell-check">
                                <span class="lm-form-label">Leave type status</span>
                                <label class="lm-form-switch">
                                    <input type="checkbox" @bind="modalActive" />
                                    <span>Active</span>
                                </label>
                            </div>
                            <div class="lm-form-cell lm-form-cell-check">
                                <span class="lm-form-label">Availability</span>
                                <label class="lm-form-switch">
                                    <input type="checkbox" @bind="modalIsAvailable" />
                                    <span>Available for this employment</span>
                                </label>
                            </div>

                            <div class="lm-form-cell lm-form-span-2">
                                <label class="lm-form-label" for="lm-order">Display order</label>
                                <input id="lm-order" class="lm-form-control lm-form-control-narrow" type="number" step="1" @bind="modalDisplayOrder" />
                            </div>
                        </div>
                        <div class="lm-form-actions">
                            <button type="button" class="lm-btn lm-btn-secondary" @onclick="CloseLeaveForm" disabled="@isSavingTypes">Cancel</button>
                            <button type="button" class="lm-btn lm-btn-primary" @onclick="SaveLeaveFormAsync" disabled="@(!CanSubmitLeaveForm || isSavingTypes)">
                                @(isSavingTypes ? "Saving..." : "Save")
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="lm-table-wrap">
                <table class="lm-table lm-table-list">
                    <thead>
                        <tr>
                            <th>Employee type</th>
                            <th>Leave type</th>
                            <th>Days</th>
                            <th class="lm-center">Avail</th>
                            <th class="lm-center">Doc</th>
                            <th>Order</th>
                            <th class="lm-center">Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in AllocationListRows)
                        {
                            <tr>
                                <td>@r.EmploymentTypeName</td>
                                <td>@r.LeaveTypeName</td>
                                <td>@r.AllocationDays.ToString("0.##")</td>
                                <td class="lm-center">@(r.IsAvailable ? "Yes" : "No")</td>
                                <td class="lm-center">@(r.RequiresDocumentForMultiDay ? "Yes" : "No")</td>
                                <td>@r.DisplayOrder</td>
                                <td class="lm-center">@(r.IsActive ? "Yes" : "No")</td>
                                <td>
                                    <button type="button" class="lm-btn lm-btn-sm lm-btn-secondary" @onclick="() => OpenEditForm(r)" disabled="@isSavingTypes">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isAuthorized;
    private bool isSavingTypes;
    private bool isSavingEmployment;
    private bool isSuccess;
    private string alertMessage = string.Empty;

    private List<EmploymentTypeManagementItem> employmentTypeRows = new();
    private List<LeaveTypeManagementItem> leaveTypeRows = new();

    private bool showLeaveForm;
    private bool leaveFormIsEdit;
    private int editLeaveTypeId;
    private int editEmploymentTypeId;
    private string modalEtName = "";
    private string modalLtName = "";

    private int modalEtId;
    private int modalLtChoice;
    private string modalNewLeaveName = "";
    private decimal modalDays;
    private bool modalIsAvailable = true;
    private bool modalDoc;
    private bool modalActive = true;
    private int modalDisplayOrder = 1;

    private string modalEtIdBind
    {
        get => modalEtId.ToString();
        set
        {
            if (int.TryParse(value, out var v))
            {
                modalEtId = v;
                ResetAddFlowAfterEt();
            }
        }
    }

    private string modalLtChoiceBind
    {
        get => modalLtChoice.ToString();
        set
        {
            if (int.TryParse(value, out var v))
            {
                modalLtChoice = v;
                modalNewLeaveName = "";
            }
        }
    }

    private IEnumerable<AllocationListRow> AllocationListRows
    {
        get
        {
            var validEt = employmentTypeRows.Where(e => e.Id > 0).OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name).ToList();
            var rows = new List<AllocationListRow>();
            foreach (var lt in leaveTypeRows.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name))
            {
                foreach (var et in validEt)
                {
                    var slot = lt.EmploymentAllocations.FirstOrDefault(a => a.EmploymentTypeId == et.Id);
                    if (slot == null) continue;
                    rows.Add(new AllocationListRow
                    {
                        LeaveTypeId = lt.Id,
                        LeaveTypeName = lt.Name,
                        EmploymentTypeId = et.Id,
                        EmploymentTypeName = et.Name,
                        AllocationDays = slot.AllocationDays,
                        IsAvailable = slot.IsAvailable,
                        RequiresDocumentForMultiDay = lt.RequiresDocumentForMultiDay,
                        DisplayOrder = lt.DisplayOrder,
                        IsActive = lt.IsActive
                    });
                }
            }
            return rows;
        }
    }

    private bool ShowAddNewLeaveName => !leaveFormIsEdit && modalLtChoice == -1;

    private bool CanSubmitLeaveForm
    {
        get
        {
            if (leaveFormIsEdit)
                return editLeaveTypeId > 0 && editEmploymentTypeId > 0;

            if (modalEtId <= 0) return false;
            if (modalLtChoice == 0) return false;
            if (modalLtChoice == -1 && string.IsNullOrWhiteSpace(modalNewLeaveName)) return false;
            return true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadPageAsync();
        StateHasChanged();
    }

    private async Task LoadPageAsync()
    {
        isLoading = true;
        alertMessage = string.Empty;

        var role = await sessionStorage.GetItemAsync<string>("adminRole");
        isAuthorized = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);

        if (!isAuthorized)
        {
            isLoading = false;
            return;
        }

        try
        {
            var empTypes = await adminPanelService.GetEmploymentTypesForManagementAsync();
            employmentTypeRows = empTypes.Select(e => new EmploymentTypeManagementItem
            {
                Id = e.Id,
                Name = e.Name,
                DisplayOrder = e.DisplayOrder,
                IsActive = e.IsActive
            }).ToList();

            var types = await adminPanelService.GetLeaveTypesForManagementAsync();
            leaveTypeRows = types.Select(MapLeaveTypeToItem).ToList();
        }
        catch (Exception ex)
        {
            isSuccess = false;
            alertMessage = $"Failed to load: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static LeaveTypeManagementItem MapLeaveTypeToItem(LeaveType t)
    {
        var item = new LeaveTypeManagementItem
        {
            Id = t.Id,
            Name = t.Name,
            RequiresDocumentForMultiDay = t.RequiresDocumentForMultiDay,
            DisplayOrder = t.DisplayOrder,
            IsActive = t.IsActive
        };
        if (t.EmploymentAllocations != null)
        {
            foreach (var a in t.EmploymentAllocations)
            {
                item.EmploymentAllocations.Add(new LeaveEmploymentAllocationItem
                {
                    EmploymentTypeId = a.EmploymentTypeId,
                    AllocationDays = a.AllocationDays,
                    IsAvailable = a.IsAvailable
                });
            }
        }
        return item;
    }

    private LeaveEmploymentAllocationItem GetAllocationSlot(LeaveTypeManagementItem row, int employmentTypeId)
    {
        var found = row.EmploymentAllocations.FirstOrDefault(a => a.EmploymentTypeId == employmentTypeId);
        if (found != null)
            return found;

        found = new LeaveEmploymentAllocationItem
        {
            EmploymentTypeId = employmentTypeId,
            AllocationDays = 0,
            IsAvailable = false
        };
        row.EmploymentAllocations.Add(found);
        return found;
    }

    private void AddEmploymentTypeRow()
    {
        var nextOrder = employmentTypeRows.Count == 0 ? 1 : employmentTypeRows.Max(r => r.DisplayOrder) + 1;
        employmentTypeRows.Add(new EmploymentTypeManagementItem
        {
            Id = 0,
            Name = "",
            DisplayOrder = nextOrder,
            IsActive = true
        });
    }

    private void ResetAddFlowAfterEt()
    {
        modalLtChoice = 0;
        modalNewLeaveName = "";
        modalDays = 0;
        modalIsAvailable = true;
        modalDoc = false;
        modalActive = true;
        modalDisplayOrder = leaveTypeRows.Count == 0 ? 1 : leaveTypeRows.Max(r => r.DisplayOrder) + 1;
    }

    private void OpenAddForm()
    {
        leaveFormIsEdit = false;
        modalEtId = 0;
        modalLtChoice = 0;
        modalNewLeaveName = "";
        modalDays = 0;
        modalIsAvailable = true;
        modalDoc = false;
        modalActive = true;
        modalDisplayOrder = leaveTypeRows.Count == 0 ? 1 : leaveTypeRows.Max(r => r.DisplayOrder) + 1;
        showLeaveForm = true;
    }

    private void OpenEditForm(AllocationListRow r)
    {
        leaveFormIsEdit = true;
        editLeaveTypeId = r.LeaveTypeId;
        editEmploymentTypeId = r.EmploymentTypeId;
        modalEtName = r.EmploymentTypeName;
        modalLtName = r.LeaveTypeName;
        modalDays = r.AllocationDays;
        modalIsAvailable = r.IsAvailable;
        modalDoc = r.RequiresDocumentForMultiDay;
        modalActive = r.IsActive;
        modalDisplayOrder = r.DisplayOrder;
        showLeaveForm = true;
    }

    private void CloseLeaveForm()
    {
        if (isSavingTypes) return;
        showLeaveForm = false;
    }

    private async Task SaveLeaveFormAsync()
    {
        if (isSavingTypes || !CanSubmitLeaveForm) return;

        isSavingTypes = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            var validEtIds = employmentTypeRows.Where(e => e.Id > 0).Select(e => e.Id).ToHashSet();

            if (leaveFormIsEdit)
            {
                var lt = leaveTypeRows.FirstOrDefault(x => x.Id == editLeaveTypeId);
                if (lt == null)
                {
                    alertMessage = "Leave type was not found.";
                    isSuccess = false;
                    return;
                }

                var slot = GetAllocationSlot(lt, editEmploymentTypeId);
                slot.AllocationDays = modalDays;
                slot.IsAvailable = modalIsAvailable;
                lt.RequiresDocumentForMultiDay = modalDoc;
                lt.IsActive = modalActive;
                lt.DisplayOrder = modalDisplayOrder;
            }
            else
            {
                if (modalLtChoice == -1)
                {
                    var name = modalNewLeaveName.Trim();
                    if (leaveTypeRows.Any(x => string.Equals(x.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)))
                    {
                        alertMessage = "A leave type with this name already exists.";
                        isSuccess = false;
                        return;
                    }

                    var row = new LeaveTypeManagementItem
                    {
                        Id = 0,
                        Name = name,
                        RequiresDocumentForMultiDay = modalDoc,
                        DisplayOrder = modalDisplayOrder,
                        IsActive = modalActive
                    };
                    foreach (var et in employmentTypeRows)
                    {
                        if (et.Id <= 0) continue;
                        row.EmploymentAllocations.Add(new LeaveEmploymentAllocationItem
                        {
                            EmploymentTypeId = et.Id,
                            AllocationDays = et.Id == modalEtId ? modalDays : 0,
                            IsAvailable = et.Id == modalEtId && modalIsAvailable
                        });
                    }
                    leaveTypeRows.Add(row);
                }
                else
                {
                    var lt = leaveTypeRows.FirstOrDefault(x => x.Id == modalLtChoice);
                    if (lt == null)
                    {
                        alertMessage = "Leave type was not found.";
                        isSuccess = false;
                        return;
                    }

                    foreach (var etId in validEtIds)
                    {
                        if (lt.EmploymentAllocations.All(a => a.EmploymentTypeId != etId))
                            lt.EmploymentAllocations.Add(new LeaveEmploymentAllocationItem { EmploymentTypeId = etId, AllocationDays = 0, IsAvailable = false });
                    }

                    var slot = GetAllocationSlot(lt, modalEtId);
                    slot.AllocationDays = modalDays;
                    slot.IsAvailable = modalIsAvailable;
                    lt.RequiresDocumentForMultiDay = modalDoc;
                    lt.IsActive = modalActive;
                    lt.DisplayOrder = modalDisplayOrder;
                }
            }

            foreach (var row in leaveTypeRows)
            {
                row.EmploymentAllocations.RemoveAll(a => !validEtIds.Contains(a.EmploymentTypeId));
                foreach (var etId in validEtIds)
                {
                    if (row.EmploymentAllocations.All(a => a.EmploymentTypeId != etId))
                        row.EmploymentAllocations.Add(new LeaveEmploymentAllocationItem { EmploymentTypeId = etId, AllocationDays = 0, IsAvailable = false });
                }
            }

            var result = await adminPanelService.SaveLeaveTypesConfigurationAsync(leaveTypeRows);
            isSuccess = result.Success;
            alertMessage = result.Message;
            if (result.Success)
            {
                var types = await adminPanelService.GetLeaveTypesForManagementAsync();
                leaveTypeRows = types.Select(MapLeaveTypeToItem).ToList();
                showLeaveForm = false;
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            alertMessage = ex.Message;
        }
        finally
        {
            isSavingTypes = false;
        }
    }

    private async Task SaveEmploymentTypes()
    {
        if (isSavingEmployment) return;
        isSavingEmployment = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            var result = await adminPanelService.SaveEmploymentTypesConfigurationAsync(employmentTypeRows);
            isSuccess = result.Success;
            alertMessage = result.Message;
            if (result.Success)
                await LoadPageAsync();
        }
        catch (Exception ex)
        {
            isSuccess = false;
            alertMessage = ex.Message;
        }
        finally
        {
            isSavingEmployment = false;
        }
    }

    private sealed class AllocationListRow
    {
        public int LeaveTypeId { get; init; }
        public string LeaveTypeName { get; init; } = "";
        public int EmploymentTypeId { get; init; }
        public string EmploymentTypeName { get; init; } = "";
        public decimal AllocationDays { get; init; }
        public bool IsAvailable { get; init; }
        public bool RequiresDocumentForMultiDay { get; init; }
        public int DisplayOrder { get; init; }
        public bool IsActive { get; init; }
    }
}
