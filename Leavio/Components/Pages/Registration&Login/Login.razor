@page "/login"
@using Leavio.Models
@using Leavio.PanelService
@using Leavio.Services
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

@inject AdminPanelService adminPanelService
@inject ISessionStorageService sessionStorage
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<div class="login-page">
    <div class="login-card">
        <h1 class="login-title">Login</h1>
        
        <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true" class="login-form">
            <div class="input-group">
                <label for="email">User Name or Email</label>
                <div class="input-wrapper">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <input type="text" id="email" @bind="loginModel.EmailId" placeholder="Enter User Name or Email" required disabled="@isProcessing" />
                </div>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <div class="input-wrapper password-wrapper">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input type="@(showPassword ? "text" : "password")" id="password" @bind="loginModel.Password" placeholder="Type your password" required disabled="@isProcessing" />
                    <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility" disabled="@isProcessing" title="@(showPassword ? "Hide password" : "Show password")">
                        @if (showPassword)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            @* CAPTCHA Section - Commented Out
            <div class="input-group">
                <label for="captcha">CAPTCHA</label>
                <div class="captcha-container">
                    <div class="captcha-display">
                        <div class="captcha-image" @ref="captchaContainer" style="@GetCaptchaBackgroundStyle()">
                            @foreach (var dot in captchaDots)
                            {
                                <div class="captcha-dot" style="@dot"></div>
                            }
                            @foreach (var line in captchaLines)
                            {
                                <div class="captcha-line" style="@line"></div>
                            }
                            @for (int i = 0; i < captchaText.Length; i++)
                            {
                                var charIndex = i;
                                var charValue = captchaText[i];
                                <span class="captcha-char" style="@GetCaptchaCharStyle(charIndex)">@charValue</span>
                            }
                        </div>
                        <button type="button" @onclick="GenerateCaptcha" class="captcha-refresh" title="Refresh CAPTCHA" disabled="@isProcessing">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <polyline points="1 20 1 14 7 14"></polyline>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="input-wrapper">
                        <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <input type="text" id="captcha" @bind="captchaAnswer" placeholder="Enter the characters above" required disabled="@isProcessing" class="@(captchaError ? "input-invalid" : "")" autocomplete="off" />
                    </div>
                    @if (captchaError)
                    {
                        <span class="validation-error">Incorrect CAPTCHA. Please try again.</span>
                    }
                </div>
            </div>
            *@

            <div class="remember-row">
                <label class="remember-label" for="rememberMe">
                    <input type="checkbox" id="rememberMe" @bind="rememberMe" disabled="@isProcessing" />
                    <span>Remember Me</span>
                </label>
            </div>

            <div class="forgot-password">
                <a href="#" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="login-button" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <text>Logging in...</text>
                }
                else
                {
                    <text>LOGIN</text>
                }
            </button>

            @if (!string.IsNullOrEmpty(alertMessage))
            {
                <div class="alert-message @(isSuccess ? "alert-success" : "alert-error")">
                    @alertMessage
                </div>
            }
        </form>

        <div class="social-separator">
            <span>Or Sign Up Using</span>
        </div>

        <div class="social-icons">
            <a href="#" class="social-icon facebook" title="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
            </a>
            <a href="#" class="social-icon twitter" title="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
                </svg>
            </a>
            <a href="#" class="social-icon google" title="Google">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
            </a>
        </div>

        <div class="register-link">
            <p>Don't Have An Account? <a href="/register">Register</a></p>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string alertMessage = string.Empty;
    private bool isProcessing = false;
    private bool isSuccess = false;
    private bool showPassword = false;
    private bool rememberMe = false;
    private const string RememberedLoginIdKey = "rememberedLoginId";
    
    // CAPTCHA variables
    private Random random = new Random();
    private string captchaText = "";
    private string captchaAnswer = "";
    private bool captchaError = false;
    private List<string> captchaLines = new();
    private List<string> captchaDots = new();
    private string captchaBackgroundStyle = "";
    private Microsoft.AspNetCore.Components.ElementReference? captchaContainer;

    protected override void OnInitialized()
    {
        // GenerateCaptcha(); // CAPTCHA commented out
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        try
        {
            var rememberedLoginId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", RememberedLoginIdKey);
            if (!string.IsNullOrWhiteSpace(rememberedLoginId))
            {
                loginModel.EmailId = rememberedLoginId;
                rememberMe = true;
                StateHasChanged();
            }
        }
        catch
        {
            // Ignore browser storage issues and keep login form usable.
        }
    }

    private void GenerateCaptcha()
    {
        // Generate random 6-character CAPTCHA (alphanumeric, excluding confusing characters)
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        captchaText = new string(Enumerable.Range(0, 6)
            .Select(_ => chars[random.Next(chars.Length)])
            .ToArray());
        
        // Generate background noise pattern
        captchaBackgroundStyle = GenerateNoiseBackground();
        
        // Generate random noise dots
        captchaDots = new List<string>();
        for (int i = 0; i < 150; i++)
        {
            var x = random.Next(0, 200);
            var y = random.Next(0, 60);
            var size = random.Next(1, 3);
            var grayValue = random.Next(100, 200);
            captchaDots.Add($"position:absolute;left:{x}px;top:{y}px;width:{size}px;height:{size}px;background:rgb({grayValue},{grayValue},{grayValue});border-radius:50%;");
        }
        
        // Generate random lines for noise (grayscale)
        captchaLines = new List<string>();
        for (int i = 0; i < 12; i++)
        {
            var x1 = random.Next(0, 200);
            var y1 = random.Next(0, 60);
            var x2 = random.Next(0, 200);
            var y2 = random.Next(0, 60);
            var grayValue = random.Next(120, 180);
            var width = random.Next(1, 2);
            var opacity = random.Next(30, 70) / 100.0;
            captchaLines.Add($"position:absolute;left:{x1}px;top:{y1}px;width:{Math.Abs(x2-x1)}px;height:{width}px;background:rgb({grayValue},{grayValue},{grayValue});transform:rotate({random.Next(-45, 45)}deg);opacity:{opacity};");
        }
        
        captchaAnswer = "";
        captchaError = false;
    }

    private string GenerateNoiseBackground()
    {
        // Create a noisy grayscale background pattern
        var baseGray = random.Next(220, 240);
        return $"background: linear-gradient(135deg, rgb({baseGray},{baseGray},{baseGray}) 0%, rgb({baseGray-10},{baseGray-10},{baseGray-10}) 100%);";
    }

    private string GetCaptchaBackgroundStyle()
    {
        return captchaBackgroundStyle;
    }

    private string GetCaptchaCharStyle(int index)
    {
        var rotation = random.Next(-30, 30);
        var fontSize = random.Next(22, 30);
        var xOffset = index * 28 + random.Next(-3, 3);
        var yOffset = random.Next(-10, 10);
        
        // Grayscale color for characters (dark gray)
        var grayValue = random.Next(30, 80);
        var charColor = $"rgb({grayValue},{grayValue},{grayValue})";
        
        // Add some skew for distortion
        var skewX = random.Next(-5, 5);
        var skewY = random.Next(-2, 2);
        
        return $"position:absolute;left:{xOffset}px;top:{15 + yOffset}px;transform:rotate({rotation}deg) skew({skewX}deg, {skewY}deg);font-size:{fontSize}px;color:{charColor};font-weight:bold;font-family:'Arial', sans-serif;z-index:3;text-shadow: 1px 1px 2px rgba(0,0,0,0.3);letter-spacing:2px;";
    }

    private bool ValidateCaptcha()
    {
        if (string.IsNullOrWhiteSpace(captchaAnswer))
        {
            captchaError = true;
            return false;
        }

        // Case-insensitive comparison
        if (string.Equals(captchaAnswer.Trim(), captchaText, StringComparison.OrdinalIgnoreCase))
        {
            captchaError = false;
            return true;
        }
        
        captchaError = true;
        return false;
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        if (isProcessing) return;

        // CAPTCHA validation commented out
        // if (!ValidateCaptcha())
        // {
        //     GenerateCaptcha(); // Generate new CAPTCHA on error
        //     return;
        // }

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;
        captchaError = false;

        try
        {
            var response = await adminPanelService.Login(loginModel);

            if (response.Success)
            {
                if (rememberMe)
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", RememberedLoginIdKey, loginModel.EmailId ?? string.Empty);
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.removeItem", RememberedLoginIdKey);
                }

                // Parse the message: "Login Successful! User ID: {id} | Name: {name} | Email: {email} | Role: {role}"
                var parts = response.Message.Split("|");
                
                if (parts.Length >= 5)
                {
                    // Extract values after colons
                    var idPart = parts[0].Split(':').LastOrDefault()?.Trim() ?? "";
                    var namePart = parts[1].Split(':').LastOrDefault()?.Trim() ?? "";
                    var emailPart = parts[2].Split(':').LastOrDefault()?.Trim() ?? "";
                    var rolePart = parts[3].Split(':').LastOrDefault()?.Trim() ?? "";
                    var employeeIdPart = parts[4].Split(':').LastOrDefault()?.Trim() ?? "";

                    await sessionStorage.SetItemAsync("adminId", idPart);
                    await sessionStorage.SetItemAsync("adminName", namePart);
                    await sessionStorage.SetItemAsync("adminEmail", emailPart);
                    await sessionStorage.SetItemAsync("adminRole", rolePart);
                    // EmployeeId is now the same as adminId (both are AdminInfo.Id)
                    await sessionStorage.SetItemAsync("employeeId", idPart);

                    await ApplyRememberMePersistenceAsync(idPart, namePart, emailPart, rolePart);
                }
                else if (parts.Length >= 4)
                {
                    // Fallback for old message format (should not happen with updated Login method)
                    var idPart = parts[0].Split(':').LastOrDefault()?.Trim() ?? "";
                    var namePart = parts[1].Split(':').LastOrDefault()?.Trim() ?? "";
                    var emailPart = parts[2].Split(':').LastOrDefault()?.Trim() ?? "";
                    var rolePart = parts[3].Split(':').LastOrDefault()?.Trim() ?? "";

                    await sessionStorage.SetItemAsync("adminId", idPart);
                    await sessionStorage.SetItemAsync("adminName", namePart);
                    await sessionStorage.SetItemAsync("adminEmail", emailPart);
                    await sessionStorage.SetItemAsync("adminRole", rolePart);
                    // EmployeeId is now the same as adminId (both are AdminInfo.Id)
                    await sessionStorage.SetItemAsync("employeeId", idPart);

                    await ApplyRememberMePersistenceAsync(idPart, namePart, emailPart, rolePart);
                }

                navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                alertMessage = response.Message;
                isSuccess = false;
                // GenerateCaptcha(); // CAPTCHA commented out
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"An error occurred: {ex.Message}";
            isSuccess = false;
            // GenerateCaptcha(); // CAPTCHA commented out
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ApplyRememberMePersistenceAsync(string idPart, string namePart, string emailPart, string rolePart)
    {
        if (rememberMe)
        {
            var map = new Dictionary<string, string>
            {
                [AuthSessionKeys.AdminId] = idPart,
                [AuthSessionKeys.AdminName] = namePart,
                [AuthSessionKeys.AdminEmail] = emailPart,
                [AuthSessionKeys.AdminRole] = rolePart,
                [AuthSessionKeys.EmployeeId] = idPart
            };
            await AuthPersistenceInterop.PersistAuthToLocalAsync(JSRuntime, map);
        }
        else
        {
            await AuthPersistenceInterop.ClearPersistedAuthAsync(JSRuntime);
        }
    }
}
