@page "/profile"
@using Leavio.DbModels
@using Leavio.PanelService
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Blazored.SessionStorage
@inject AdminPanelService adminPanelService
@inject ISessionStorageService sessionStorage
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<PageTitle>Profile</PageTitle>

<div class="profile-container">
    <div class="profile-header">
        <h1>User Profile</h1>
        <p class="subtitle">Manage your profile information</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-message">
            <p>Loading profile...</p>
        </div>
    }
    else if (userProfile == null)
    {
        <div class="error-message">
            <p>Unable to load profile. Please try again.</p>
        </div>
    }
    else
    {
        <div class="profile-card">
            <div class="profile-picture-section">
                <div class="profile-picture-container">
                    @if (!string.IsNullOrEmpty(previewImageUrl))
                    {
                        <img src="@previewImageUrl" alt="Profile Picture Preview" class="profile-picture" />
                    }
                    else if (!string.IsNullOrEmpty(userProfile.ProfilePicture))
                    {
                        <img src="@userProfile.ProfilePicture" alt="Profile Picture" class="profile-picture" />
                    }
                    else
                    {
                        <div class="profile-picture-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                    }
                </div>
                <div class="profile-picture-actions">
                    <div class="file-input-wrapper">
                        <InputFile OnChange="HandleFileSelection" accept="image/*" class="file-input-hidden" id="profilePictureInput" style="display: none;" />
                        <label for="profilePictureInput" class="btn-choose-file">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            Choose File
                        </label>
                    </div>
                    @if (selectedFile != null)
                    {
                        <span class="selected-file-name">@selectedFile.Name</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(uploadMessage))
                {
                    <div class="upload-status @(uploadSuccess ? "success" : "error")">@uploadMessage</div>
                }
            </div>

            <div class="profile-form">
                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <div class="input-with-edit">
                        <input type="text" 
                               id="fullName" 
                               @bind="editableName" 
                               @bind:event="oninput"
                               class="form-control" 
                               disabled="@(!isEditingName)" />
                        <button class="edit-button" @onclick="ToggleNameEdit">
                            @if (isEditingName)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" 
                           id="email" 
                           value="@userProfile.Email" 
                           class="form-control" 
                           disabled />
                    <small class="form-text">Email cannot be changed</small>
                </div>

                <div class="form-group">
                    <label for="phoneNumber">Phone Number</label>
                    <div class="input-with-edit">
                        <input type="tel" 
                               id="phoneNumber" 
                               @bind="editablePhoneNumber" 
                               @bind:event="oninput"
                               class="form-control" 
                               placeholder="Enter phone number"
                               disabled="@(!isEditingPhone)" />
                        <button class="edit-button" @onclick="TogglePhoneEdit">
                            @if (isEditingPhone)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="userId">User ID</label>
                    <input type="text" 
                           id="userId" 
                           value="@userProfile.UserId" 
                           class="form-control" 
                           disabled />
                    <small class="form-text">User ID cannot be changed</small>
                </div>
            </div>

            @if (isEditingName || isEditingPhone || selectedFile != null)
            {
                <div class="profile-actions">
                    <button class="btn btn-cancel" @onclick="CancelAllChanges">Cancel</button>
                    <button class="btn btn-save" @onclick="SaveAllChanges" disabled="@isUploadingPicture">
                        @if (isUploadingPicture)
                        {
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert-message @(isSuccess ? "alert-success" : "alert-error")">
            @alertMessage
        </div>
    }
</div>

@code {
    private AdminInfo? userProfile;
    private bool isLoading = true;
    private bool isEditingName = false;
    private bool isEditingPhone = false;
    private string editableName = string.Empty;
    private string editablePhoneNumber = string.Empty;
    private string originalName = string.Empty;
    private string originalPhoneNumber = string.Empty;
    private string alertMessage = string.Empty;
    private bool isSuccess = false;
    private IBrowserFile? selectedFile = null;
    private string previewImageUrl = string.Empty;
    private bool isUploadingPicture = false;
    private string uploadMessage = string.Empty;
    private bool uploadSuccess = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProfile();
        }
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            var employeeIdStr = await sessionStorage.GetItemAsync<string>("employeeId");
            if (!string.IsNullOrEmpty(employeeIdStr) && int.TryParse(employeeIdStr, out var employeeId))
            {
                var allUsers = await adminPanelService.GetAllUsersAsync();
                userProfile = allUsers.FirstOrDefault(u => u.Id == employeeId);
                
                if (userProfile != null)
                {
                    editableName = userProfile.Name;
                    editablePhoneNumber = userProfile.PhoneNumber ?? string.Empty;
                    originalName = userProfile.Name;
                    originalPhoneNumber = userProfile.PhoneNumber ?? string.Empty;
                }
            }
            else
            {
                navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error loading profile: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleNameEdit()
    {
        if (isEditingName)
        {
            // If already editing, clicking again will be handled by Save button
            return;
        }
        isEditingName = true;
        originalName = editableName;
        StateHasChanged();
    }

    private void TogglePhoneEdit()
    {
        if (isEditingPhone)
        {
            // If already editing, clicking again will be handled by Save button
            return;
        }
        isEditingPhone = true;
        originalPhoneNumber = editablePhoneNumber;
        StateHasChanged();
    }

    private async Task SaveAllChanges()
    {
        if (string.IsNullOrWhiteSpace(editableName))
        {
            alertMessage = "Name cannot be empty";
            isSuccess = false;
            StateHasChanged();
            return;
        }

        try
        {
            // Save profile picture first if one was selected
            if (selectedFile != null)
            {
                await SaveProfilePicture();
                if (!uploadSuccess)
                {
                    // If picture upload failed, don't proceed with other updates
                    return;
                }
            }

            // Save name and phone number
            var result = await adminPanelService.UpdateProfileAsync(
                userProfile!.UserId!,
                editableName,
                userProfile.Email,
                editablePhoneNumber
            );

            if (result.Success)
            {
                userProfile.Name = editableName;
                userProfile.PhoneNumber = editablePhoneNumber;
                originalName = editableName;
                originalPhoneNumber = editablePhoneNumber;
                isEditingName = false;
                isEditingPhone = false;
                alertMessage = "Profile updated successfully";
                isSuccess = true;
            }
            else
            {
                alertMessage = result.Message;
                isSuccess = false;
                editableName = originalName;
                editablePhoneNumber = originalPhoneNumber;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error updating profile: {ex.Message}";
            isSuccess = false;
            editableName = originalName;
            editablePhoneNumber = originalPhoneNumber;
        }

        StateHasChanged();
    }

    private void CancelAllChanges()
    {
        editableName = originalName;
        editablePhoneNumber = originalPhoneNumber;
        isEditingName = false;
        isEditingPhone = false;
        selectedFile = null;
        previewImageUrl = string.Empty;
        uploadMessage = string.Empty;
        alertMessage = string.Empty;
        StateHasChanged();
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;

        try
        {
            var maxFileSize = 5 * 1024 * 1024; // 5MB
            if (e.File.Size > maxFileSize)
            {
                uploadMessage = "File size must be less than 5MB";
                uploadSuccess = false;
                selectedFile = null;
                previewImageUrl = string.Empty;
                StateHasChanged();
                return;
            }

            selectedFile = e.File;
            uploadMessage = string.Empty;

            // Create preview
            var imageStream = e.File.OpenReadStream(maxFileSize);
            var memoryStream = new MemoryStream();
            await imageStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            var imageBytes = memoryStream.ToArray();
            previewImageUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(imageBytes)}";
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error selecting file: {ex.Message}";
            uploadSuccess = false;
            selectedFile = null;
            previewImageUrl = string.Empty;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SaveProfilePicture()
    {
        if (selectedFile == null || userProfile == null) return;

        isUploadingPicture = true;
        uploadMessage = string.Empty;
        uploadSuccess = false;
        StateHasChanged();

        try
        {
            var maxFileSize = 5 * 1024 * 1024; // 5MB

            // Create profile pictures directory if it doesn't exist
            var profilePicturesPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "Images", "ProfilePictures");
            if (!Directory.Exists(profilePicturesPath))
            {
                Directory.CreateDirectory(profilePicturesPath);
            }

            // Generate unique filename
            var fileExtension = Path.GetExtension(selectedFile.Name);
            var fileName = $"{userProfile.Id}_{DateTime.Now:yyyyMMddHHmmss}{fileExtension}";
            var filePath = Path.Combine(profilePicturesPath, fileName);
            var relativePath = $"/Images/ProfilePictures/{fileName}";

            // Save file
            using (var stream = File.Create(filePath))
            {
                await selectedFile.OpenReadStream(maxFileSize).CopyToAsync(stream);
            }

            // Update profile in database
            var result = await adminPanelService.UpdateProfilePictureAsync(userProfile.UserId!, relativePath);

            if (result.Success)
            {
                userProfile.ProfilePicture = relativePath;
                previewImageUrl = string.Empty;
                selectedFile = null;
                uploadSuccess = true;
            }
            else
            {
                uploadMessage = result.Message;
                uploadSuccess = false;
                // Delete uploaded file if database update failed
                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                }
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error uploading picture: {ex.Message}";
            uploadSuccess = false;
        }
        finally
        {
            isUploadingPicture = false;
            StateHasChanged();
        }
    }
}
