@page "/role-management"
@using Leavio.DbModels
@using Leavio.PanelService
@using Leavio.Models
@using Microsoft.EntityFrameworkCore
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.Components

@inject AdminPanelService adminPanelService
@inject IDbContextFactory<RegesterServiceContext> contextFactory
@inject ISessionStorageService sessionStorage
@inject NavigationManager navigation

<PageTitle>Role Management</PageTitle>

@if (isCheckingAuth)
{
    <div class="loading-message">
        <div class="spinner"></div>
        <p>Checking authorization...</p>
    </div>
}
else if (!isAuthorized)
{
    <div class="unauthorized-message">
        <h2>Access Denied</h2>
        <p>You do not have permission to access this page. Admin role required.</p>
        <a href="/">Return to Home</a>
    </div>
}
else
{
<div class="role-management-page">
    <div class="role-management-card">
        <div class="page-header">
            <h1 class="page-title">Role Management</h1>
            <button type="button" class="btn-add-role" @onclick="OpenAddRoleModal" disabled="@isProcessing">
                Add Role
            </button>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert-message @(isSuccess ? "alert-success" : "alert-error")">
                @alertMessage
            </div>
        }

        <!-- System Settings Section -->
        <div class="system-settings-section">
            <h2>System Settings</h2>
            <div class="settings-item">
                <div class="settings-label-group">
                    <label for="registrationEnabled">User Registration</label>
                    <span class="settings-description">Enable or disable user registration page</span>
                </div>
                <div class="toggle-switch">
                    <input type="checkbox" id="registrationEnabled" @bind="registrationEnabled" @bind:after="OnRegistrationToggleChanged" disabled="@isProcessing" />
                    <label for="registrationEnabled" class="toggle-label">
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="toggle-status">@(registrationEnabled ? "Enabled" : "Disabled")</span>
                </div>
            </div>
        </div>

        <div class="roles-list-section">
            <h2>Existing Roles</h2>
            @if (roles.Any())
            {
                <div class="table-container">
                    <table class="roles-table">
                        <thead>
                            <tr>
                                <th>SL No.</th>
                                <th class="sortable" @onclick='() => SortByColumn("RoleName")'>
                                    Role Name
                                    @if (sortColumn == "RoleName")
                                    {
                                        <span class="sort-icon">@(sortDirection == "asc" ? "▲" : "▼")</span>
                                    }
                                    else
                                    {
                                        <span class="sort-icon" style="opacity: 0.3;">⇅</span>
                                    }
                                </th>
                                <th class="sortable" @onclick='() => SortByColumn("Description")'>
                                    Description
                                    @if (sortColumn == "Description")
                                    {
                                        <span class="sort-icon">@(sortDirection == "asc" ? "▲" : "▼")</span>
                                    }
                                    else
                                    {
                                        <span class="sort-icon" style="opacity: 0.3;">⇅</span>
                                    }
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in paginatedRoles.Select((role, index) => new { role, index }))
                            {
                                var serialNumber = (currentPage - 1) * pageSize + item.index + 1;
                                <tr>
                                    <td>@serialNumber</td>
                                    <td>@item.role.RoleName</td>
                                    <td>@(item.role.Description ?? "N/A")</td>
                                    <td>
                                        <div class="role-actions">
                                            <button @onclick="() => NavigateToRolePermissions(item.role.Id)" class="btn-permissions" disabled="@isProcessing">Permissions</button>
                                            <button @onclick="() => OpenEditRoleModal(item.role)" class="btn-edit-role" disabled="@isProcessing">Edit</button>
                                            <button @onclick="() => DeleteRole(item.role.Id)" class="btn-delete" disabled="@isProcessing">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                @if (totalPages > 0)
                {
                    <div class="pagination-container">
                        <div class="pagination-info">
                            Showing @((currentPage - 1) * pageSize + 1) to @(Math.Min(currentPage * pageSize, totalRecords)) of @totalRecords entries
                        </div>
                        <div class="pagination-controls">
                            <button @onclick="GoToFirstPage" class="pagination-btn" disabled="@(currentPage == 1 || isProcessing)" title="First Page">
                                &laquo;&laquo;
                            </button>
                            <button @onclick="GoToPreviousPage" class="pagination-btn" disabled="@(currentPage == 1 || isProcessing)" title="Previous">
                                &laquo;
                            </button>
                            
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <button @onclick="() => GoToPage(pageNum)" class="pagination-btn @(currentPage == pageNum ? "active" : "")" disabled="@isProcessing">
                                    @pageNum
                                </button>
                            }
                            
                            <button @onclick="GoToNextPage" class="pagination-btn" disabled="@(currentPage == totalPages || isProcessing)" title="Next">
                                &raquo;
                            </button>
                            <button @onclick="GoToLastPage" class="pagination-btn" disabled="@(currentPage == totalPages || isProcessing)" title="Last Page">
                                &raquo;&raquo;
                            </button>
                        </div>
                        <div class="pagination-page-size">
                            <label for="pageSizeSelect">Items per page:</label>
                            <select id="pageSizeSelect" @bind="pageSize" @bind:after="OnPageSizeChanged" class="page-size-select" disabled="@isProcessing">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="no-roles">No roles found. Please add a role above.</p>
            }
        </div>

        @if (showRoleModal)
        {
            <div class="modal-overlay" @onclick="CloseRoleModal">
                <div class="modal-content" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h2 class="modal-title">@(editingRole != null ? "Edit Role" : "Add Role")</h2>
                        <button type="button" class="modal-close" @onclick="CloseRoleModal" aria-label="Close">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form @onsubmit="HandleSaveRole" @onsubmit:preventDefault="true" class="role-form">
                            <div class="form-group">
                                <label for="modalRoleName">Role Name</label>
                                <input type="text"
                                       id="modalRoleName"
                                       @bind="modalRoleName"
                                       placeholder="Enter role name (e.g., Admin, User)"
                                       required
                                       disabled="@isProcessing"
                                       class="form-control" />
                            </div>
                            <div class="form-group">
                                <label for="modalRoleDescription">Description (Optional)</label>
                                <textarea id="modalRoleDescription"
                                          @bind="modalRoleDescription"
                                          placeholder="Enter role description"
                                          disabled="@isProcessing"
                                          class="form-control"
                                          rows="3"></textarea>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-add-role" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <text>@(editingRole != null ? "Saving..." : "Adding...")</text>
                                    }
                                    else
                                    {
                                        <text>@(editingRole != null ? "Save Changes" : "Add Role")</text>
                                    }
                                </button>
                                <button type="button" class="btn-cancel-role" @onclick="CloseRoleModal" disabled="@isProcessing">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="back-link">
            <a href="/">Back to Home</a>
        </div>
    </div>
</div>
}

@code {
    private List<DbModels.Role> roles = new();
    private DbModels.Role? editingRole = null;
    private string modalRoleName = string.Empty;
    private string? modalRoleDescription = string.Empty;
    private string alertMessage = string.Empty;
    private bool isProcessing = false;
    private bool isSuccess = false;
    private bool isAuthorized = false;
    private bool isCheckingAuth = true;
    private bool registrationEnabled = true;
    private bool showRoleModal = false;
    
    // Pagination variables
    private int currentPage = 1;
    private int pageSize = 10;
    private string sortColumn = "RoleName";
    private string sortDirection = "asc";
    private int totalPages => (int)Math.Ceiling((double)sortedRoles.Count() / pageSize);
    private int totalRecords => sortedRoles.Count();
    private int startPage => Math.Max(1, currentPage - 2);
    private int endPage => Math.Min(totalPages, currentPage + 2);
    
    // Sorted data
    private IEnumerable<DbModels.Role> sortedRoles
    {
        get
        {
            if (roles == null || !roles.Any())
                return Enumerable.Empty<DbModels.Role>();
            
            var sorted = roles.AsEnumerable();
            
            switch (sortColumn)
            {
                case "Id":
                    sorted = sortDirection == "asc" 
                        ? sorted.OrderBy(x => x.Id)
                        : sorted.OrderByDescending(x => x.Id);
                    break;
                case "RoleName":
                    sorted = sortDirection == "asc"
                        ? sorted.OrderBy(x => x.RoleName ?? "")
                        : sorted.OrderByDescending(x => x.RoleName ?? "");
                    break;
                case "Description":
                    sorted = sortDirection == "asc"
                        ? sorted.OrderBy(x => x.Description ?? "N/A")
                        : sorted.OrderByDescending(x => x.Description ?? "N/A");
                    break;
            }
            
            return sorted;
        }
    }
    
    // Paginated data
    private IEnumerable<DbModels.Role> paginatedRoles => sortedRoles
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthorization();
            if (isAuthorized)
            {
                await LoadRoles();
                await LoadRegistrationSetting();
            }
            isCheckingAuth = false;
            StateHasChanged();
        }
    }

    private async Task LoadRegistrationSetting()
    {
        try
        {
            registrationEnabled = await adminPanelService.IsRegistrationEnabledAsync();
        }
        catch (Exception)
        {
            registrationEnabled = true; // Default to enabled on error
        }
    }

    private async Task OnRegistrationToggleChanged()
    {
        if (isProcessing) return;

        isProcessing = true;
        try
        {
            var response = await adminPanelService.SetRegistrationEnabledAsync(registrationEnabled);
            alertMessage = response.Message;
            isSuccess = response.Success;
        }
        catch (Exception ex)
        {
            alertMessage = $"Error updating setting: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CheckAuthorization()
    {
        var storedUserRole = await sessionStorage.GetItemAsync<string>("adminRole");
        if (string.IsNullOrEmpty(storedUserRole))
        {
            // Not logged in, redirect to login
            isCheckingAuth = false;
            navigation.NavigateTo("/login");
            return;
        }

        isAuthorized = string.Equals(storedUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
        if (!isAuthorized)
        {
            // Not an admin, stay on page but show access denied message
            // (Navigation is handled by the UI)
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            roles = await adminPanelService.GetAllRolesAsync();
            
            // Adjust current page if it's beyond total pages
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
            }
            else if (totalPages == 0)
            {
                currentPage = 1;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error loading roles: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task HandleSaveRole()
    {
        if (isProcessing) return;

        if (string.IsNullOrWhiteSpace(modalRoleName))
        {
            alertMessage = "Role name is required.";
            isSuccess = false;
            StateHasChanged();
            return;
        }

        modalRoleName = modalRoleName.Trim();
        modalRoleDescription = modalRoleDescription?.Trim();

        if (modalRoleName.Length > 50)
        {
            alertMessage = "Role name cannot exceed 50 characters.";
            isSuccess = false;
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrWhiteSpace(modalRoleDescription) && modalRoleDescription.Length > 500)
        {
            alertMessage = "Description cannot exceed 500 characters.";
            isSuccess = false;
            StateHasChanged();
            return;
        }

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            using var context = await contextFactory.CreateDbContextAsync();

            var existingRole = await context.Roles
                .AsNoTracking()
                .FirstOrDefaultAsync(r =>
                    r.RoleName.ToLower() == modalRoleName.ToLower() &&
                    (editingRole == null || r.Id != editingRole.Id));
            if (existingRole != null)
            {
                alertMessage = "A role with this name already exists.";
                isSuccess = false;
                return;
            }

            if (editingRole == null)
            {
                var newRole = new DbModels.Role
                {
                    RoleName = modalRoleName,
                    Description = modalRoleDescription
                };

                await context.Roles.AddAsync(newRole);
                await context.SaveChangesAsync();

                alertMessage = "Role added successfully!";
            }
            else
            {
                var role = await context.Roles.FirstOrDefaultAsync(r => r.Id == editingRole.Id);
                if (role == null)
                {
                    alertMessage = "Role not found.";
                    isSuccess = false;
                    return;
                }

                role.RoleName = modalRoleName;
                role.Description = modalRoleDescription;
                await context.SaveChangesAsync();

                alertMessage = "Role updated successfully!";
            }

            AdminPanelService.InvalidateRolesCache();

            isSuccess = true;
            showRoleModal = false;
            await LoadRoles();
            if (totalPages > 0 && editingRole == null)
            {
                currentPage = totalPages;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error saving role: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteRole(int roleId)
    {
        if (isProcessing) return;

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            using var context = await contextFactory.CreateDbContextAsync();

            var usersWithRole = await context.UserRoles
                .AsNoTracking()
                .AnyAsync(ur => ur.RoleId == roleId);
            if (usersWithRole)
            {
                alertMessage = "Cannot delete role. It is assigned to one or more users.";
                isSuccess = false;
                isProcessing = false;
                StateHasChanged();
                return;
            }

            var role = await context.Roles.FindAsync(roleId);
            if (role != null)
            {
                context.Roles.Remove(role);
                await context.SaveChangesAsync();
                
                // Invalidate roles cache
                AdminPanelService.InvalidateRolesCache();
                
                alertMessage = "Role deleted successfully!";
                isSuccess = true;
                await LoadRoles();
                // Reset to first page if current page is empty after deletion
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                }
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error deleting role: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // Pagination methods
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && !isProcessing)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void GoToNextPage()
    {
        if (currentPage < totalPages && !isProcessing)
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private void GoToPreviousPage()
    {
        if (currentPage > 1 && !isProcessing)
        {
            currentPage--;
            StateHasChanged();
        }
    }

    private void GoToFirstPage()
    {
        if (currentPage != 1 && !isProcessing)
        {
            currentPage = 1;
            StateHasChanged();
        }
    }

    private void GoToLastPage()
    {
        if (currentPage != totalPages && totalPages > 0 && !isProcessing)
        {
            currentPage = totalPages;
            StateHasChanged();
        }
    }

    private void OnPageSizeChanged()
    {
        // Reset to first page when page size changes
        currentPage = 1;
        StateHasChanged();
    }

    private void SortByColumn(string column)
    {
        if (isProcessing) return;

        if (sortColumn == column)
        {
            // Toggle sort direction if clicking the same column
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            // Set new sort column and default to ascending
            sortColumn = column;
            sortDirection = "asc";
        }

        // Reset to first page when sorting changes
        currentPage = 1;
        StateHasChanged();
    }

    private void NavigateToRolePermissions(int roleId)
    {
        if (!isProcessing)
        {
            navigation.NavigateTo($"/role-permissions/{roleId}");
        }
    }

    private void OpenAddRoleModal()
    {
        if (isProcessing) return;

        editingRole = null;
        modalRoleName = string.Empty;
        modalRoleDescription = string.Empty;
        showRoleModal = true;
    }

    private void OpenEditRoleModal(DbModels.Role role)
    {
        if (isProcessing) return;

        editingRole = role;
        modalRoleName = role.RoleName ?? string.Empty;
        modalRoleDescription = role.Description ?? string.Empty;
        showRoleModal = true;
    }

    private void CloseRoleModal()
    {
        if (isProcessing) return;

        showRoleModal = false;
        editingRole = null;
        modalRoleName = string.Empty;
        modalRoleDescription = string.Empty;
        StateHasChanged();
    }
}
