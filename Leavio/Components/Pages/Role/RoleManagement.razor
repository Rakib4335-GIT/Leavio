@page "/role-management"
@using Leavio.DbModels
@using Leavio.PanelService
@using Leavio.Models
@using Microsoft.EntityFrameworkCore
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.Components

@inject AdminPanelService adminPanelService
@inject IDbContextFactory<RegesterServiceContext> contextFactory
@inject ISessionStorageService sessionStorage
@inject NavigationManager navigation

<PageTitle>Role Management</PageTitle>

@if (isCheckingAuth)
{
    <div class="loading-message">
        <div class="spinner"></div>
        <p>Checking authorization...</p>
    </div>
}
else if (!isAuthorized)
{
    <div class="unauthorized-message">
        <h2>Access Denied</h2>
        <p>You do not have permission to access this page. Admin role required.</p>
        <a href="/">Return to Home</a>
    </div>
}
else
{
<div class="role-management-page">
    <div class="role-management-card">
        <h1 class="page-title">Role Management</h1>

        <div class="add-role-section">
            <h2>Add New Role</h2>
            <form @onsubmit="HandleAddRole" @onsubmit:preventDefault="true" class="role-form">
                <div class="form-group">
                    <label for="roleName">Role Name</label>
                    <input type="text" id="roleName" @bind="newRole.RoleName" placeholder="Enter role name (e.g., Admin, User)" required disabled="@isProcessing" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="roleDescription">Description (Optional)</label>
                    <textarea id="roleDescription" @bind="newRole.Description" placeholder="Enter role description" disabled="@isProcessing" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn-add-role" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <text>Adding...</text>
                    }
                    else
                    {
                        <text>Add Role</text>
                    }
                </button>
            </form>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert-message @(isSuccess ? "alert-success" : "alert-error")">
                @alertMessage
            </div>
        }

        <!-- System Settings Section -->
        <div class="system-settings-section">
            <h2>System Settings</h2>
            <div class="settings-item">
                <div class="settings-label-group">
                    <label for="registrationEnabled">User Registration</label>
                    <span class="settings-description">Enable or disable user registration page</span>
                </div>
                <div class="toggle-switch">
                    <input type="checkbox" id="registrationEnabled" @bind="registrationEnabled" @bind:after="OnRegistrationToggleChanged" disabled="@isProcessing" />
                    <label for="registrationEnabled" class="toggle-label">
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="toggle-status">@(registrationEnabled ? "Enabled" : "Disabled")</span>
                </div>
            </div>
        </div>

        <div class="roles-list-section">
            <h2>Existing Roles</h2>
            @if (roles.Any())
            {
                <table class="roles-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Role Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in roles)
                        {
                            <tr>
                                <td>@role.Id</td>
                                <td>@role.RoleName</td>
                                <td>@(role.Description ?? "N/A")</td>
                                <td>
                                    <button @onclick="() => DeleteRole(role.Id)" class="btn-delete" disabled="@isProcessing">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="no-roles">No roles found. Please add a role above.</p>
            }
        </div>

        <div class="back-link">
            <a href="/">Back to Home</a>
        </div>
    </div>
</div>
}

@code {
    private List<DbModels.Role> roles = new();
    private DbModels.Role newRole = new();
    private string alertMessage = string.Empty;
    private bool isProcessing = false;
    private bool isSuccess = false;
    private bool isAuthorized = false;
    private bool isCheckingAuth = true;
    private bool registrationEnabled = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthorization();
            if (isAuthorized)
            {
                await LoadRoles();
                await LoadRegistrationSetting();
            }
            isCheckingAuth = false;
            StateHasChanged();
        }
    }

    private async Task LoadRegistrationSetting()
    {
        try
        {
            registrationEnabled = await adminPanelService.IsRegistrationEnabledAsync();
        }
        catch (Exception)
        {
            registrationEnabled = true; // Default to enabled on error
        }
    }

    private async Task OnRegistrationToggleChanged()
    {
        if (isProcessing) return;

        isProcessing = true;
        try
        {
            var response = await adminPanelService.SetRegistrationEnabledAsync(registrationEnabled);
            alertMessage = response.Message;
            isSuccess = response.Success;
        }
        catch (Exception ex)
        {
            alertMessage = $"Error updating setting: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CheckAuthorization()
    {
        var storedUserRole = await sessionStorage.GetItemAsync<string>("adminRole");
        if (string.IsNullOrEmpty(storedUserRole))
        {
            // Not logged in, redirect to login
            isCheckingAuth = false;
            navigation.NavigateTo("/login");
            return;
        }

        isAuthorized = string.Equals(storedUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
        if (!isAuthorized)
        {
            // Not an admin, stay on page but show access denied message
            // (Navigation is handled by the UI)
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            roles = await adminPanelService.GetAllRolesAsync();
        }
        catch (Exception ex)
        {
            alertMessage = $"Error loading roles: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task HandleAddRole()
    {
        if (isProcessing) return;

        if (string.IsNullOrWhiteSpace(newRole.RoleName))
        {
            alertMessage = "Role name is required.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            using var context = await contextFactory.CreateDbContextAsync();

            // Check if role name already exists
            var existingRole = await context.Roles
                .AsNoTracking()
                .FirstOrDefaultAsync(r => r.RoleName.ToLower() == newRole.RoleName.ToLower());
            if (existingRole != null)
            {
                alertMessage = "A role with this name already exists.";
                isSuccess = false;
                return;
            }

            await context.Roles.AddAsync(newRole);
            await context.SaveChangesAsync();

            // Invalidate roles cache
            AdminPanelService.InvalidateRolesCache();

            alertMessage = "Role added successfully!";
            isSuccess = true;
            newRole = new DbModels.Role();
            await LoadRoles();
        }
        catch (Exception ex)
        {
            alertMessage = $"Error adding role: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DeleteRole(int roleId)
    {
        if (isProcessing) return;

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            using var context = await contextFactory.CreateDbContextAsync();

            var usersWithRole = await context.UserRoles
                .AsNoTracking()
                .AnyAsync(ur => ur.RoleId == roleId);
            if (usersWithRole)
            {
                alertMessage = "Cannot delete role. It is assigned to one or more users.";
                isSuccess = false;
                return;
            }

            var role = await context.Roles.FindAsync(roleId);
            if (role != null)
            {
                context.Roles.Remove(role);
                await context.SaveChangesAsync();
                
                // Invalidate roles cache
                AdminPanelService.InvalidateRolesCache();
                
                alertMessage = "Role deleted successfully!";
                isSuccess = true;
                await LoadRoles();
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error deleting role: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
