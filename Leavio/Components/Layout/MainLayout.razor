@using Blazored.SessionStorage
@inject ISessionStorageService sessionStorage
@inherits LayoutComponentBase
@inject NavigationManager navigation

<div class="page" @onclick="HandlePageClick">

    <header class="header">
        <div>
            <img src="Images/Favicon1.png" alt="Logo" class="logo" @onclick="ShowImageModal" style="cursor: pointer;">
            <span class="header-title">Leavio</span>
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/aboutUs">About Us</a>
            <a href="/contact">Contact</a>
            @if (isLoggedIn && isAdmin)
            {
                <div class="menu-dropdown" @onclick:stopPropagation="true">
                    <button class="menu-trigger" @onclick="ToggleMenu">
                        <span>Admin Menu</span>
                        <span class="menu-arrow @(showMenu ? "open" : "")">▼</span>
                    </button>
                    @if (showMenu)
                    {
                        <div class="menu-dropdown-content">
                            <a href="/role-management" class="menu-button" @onclick="CloseMenu">ROLE MANAGEMENT</a>
                            <a href="/user-role-management" class="menu-button" @onclick="CloseMenu">USER ROLES</a>
                        </div>
                    }
                </div>
            }
        </div>




        <div class="header-button">
            @if (isLoggedIn)
            {
                <span class="welcome-message">Welcome, @userName! (@userRole)</span>
                <button @onclick="Logout" class="btn btn-danger logout-btn">Logout</button>
            }
            else
            {
                <button @onclick="NavigateToLogin" class="btn btn-primary">Login</button>
                <button @onclick="NavigateToRegister" class="btn btn-danger">Register</button>
            }

        </div>

    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<ImageModal IsVisible="@showImageModal" 
           ImageSrc="Images/Favicon1.png" 
           ImageAlt="Leavio Logo" 
           OnClose="@(() => showImageModal = false)" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private bool isLoggedIn = false;
    private string userName = string.Empty;
    private string userRole = string.Empty;
    private bool isAdmin = false;
    private bool showImageModal = false;
    private bool showMenu = false;

    private void ShowImageModal()
    {
        showImageModal = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedUserName = await sessionStorage.GetItemAsync<string>("adminName");
            var storedUserRole = await sessionStorage.GetItemAsync<string>("adminRole");
            if (!string.IsNullOrEmpty(storedUserName))
            {
                isLoggedIn = true;
                userName = storedUserName;
                userRole = storedUserRole ?? "User";
                isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
                StateHasChanged();
            }
        }
    }
    
    private async Task Logout()
    {
        await sessionStorage.ClearAsync();
        isLoggedIn = false;
        userName = string.Empty;
        userRole = string.Empty;
        isAdmin = false;
        navigation.NavigateTo("/login");
    }

    private void NavigateToLogin()
    {
        navigation.NavigateTo("/login");
    }
    private void NavigateToRegister()
    {
        navigation.NavigateTo("/register");
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private void CloseMenu()
    {
        showMenu = false;
    }

    private void HandlePageClick()
    {
        if (showMenu)
        {
            showMenu = false;
            StateHasChanged();
        }
    }
}
