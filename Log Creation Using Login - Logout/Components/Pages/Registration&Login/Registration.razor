@page "/register"
@using Log_Creation_Using_Login___Logout.Models
@using Log_Creation_Using_Login___Logout.PanelService

@inject AdminPanelService adminPanelService


<div class="container">
    <h3>Regestration</h3>
</div>
<form @onsubmit="HandleRegistration">
    <label>Name:</label>
    <input type="text" @bind="registrationModel.Name" />

    <label>Email:</label>
    <input type="email" @bind="registrationModel.Email" />

    <label>Password:</label>
    <input type="password" @bind="registrationModel.Password" />

    <button type="submit">Register</button>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-info">@alertMessage</div>
    }
    <p>Already Have An Account<a href="/login">Login</a></p>
</form>

@code {
    private RegistrationModel registrationModel = new ();
    private string alertMessage;
    private async Task HandleRegistration()
    {
        // Handle registration logic here
        var registtrationResponse = await adminPanelService.Register(registrationModel);
        alertMessage = registtrationResponse.Message;
    }
}
