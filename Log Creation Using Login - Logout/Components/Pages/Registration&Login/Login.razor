@page "/login"
@using Log_Creation_Using_Login___Logout.Models
@using Log_Creation_Using_Login___Logout.PanelService
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.Components

@inject AdminPanelService adminPanelService
@inject ISessionStorageService sessionStorage
@inject NavigationManager navigation

<div class="login-page">
    <div class="login-card">
        <h1 class="login-title">Login</h1>
        
        <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true" class="login-form">
            <div class="input-group">
                <label for="email">Email</label>
                <div class="input-wrapper">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <input type="email" id="email" @bind="loginModel.EmailId" placeholder="Type your email" required disabled="@isProcessing" />
                </div>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input type="password" id="password" @bind="loginModel.Password" placeholder="Type your password" required disabled="@isProcessing" />
                </div>
            </div>

            <div class="forgot-password">
                <a href="#" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="login-button" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <text>Logging in...</text>
                }
                else
                {
                    <text>LOGIN</text>
                }
            </button>

            @if (!string.IsNullOrEmpty(alertMessage))
            {
                <div class="alert-message @(isSuccess ? "alert-success" : "alert-error")">
                    @alertMessage
                </div>
            }
        </form>

        <div class="social-separator">
            <span>Or Sign Up Using</span>
        </div>

        <div class="social-icons">
            <a href="#" class="social-icon facebook" title="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
            </a>
            <a href="#" class="social-icon twitter" title="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
                </svg>
            </a>
            <a href="#" class="social-icon google" title="Google">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
            </a>
        </div>

        <div class="register-link">
            <p>Don't Have An Account? <a href="/register">Register</a></p>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string alertMessage = string.Empty;
    private bool isProcessing = false;
    private bool isSuccess = false;

    private async Task HandleLogin()
    {
        if (isProcessing) return;

        isProcessing = true;
        alertMessage = string.Empty;
        isSuccess = false;

        try
        {
            var response = await adminPanelService.Login(loginModel);

            if (response.Success)
            {
                // Parse the message: "Login Successful! User ID: {id} | Name: {name} | Email: {email}"
                var parts = response.Message.Split("|");
                
                if (parts.Length >= 3)
                {
                    // Extract values after colons
                    var idPart = parts[0].Split(':').LastOrDefault()?.Trim() ?? "";
                    var namePart = parts[1].Split(':').LastOrDefault()?.Trim() ?? "";
                    var emailPart = parts[2].Split(':').LastOrDefault()?.Trim() ?? "";

                    await sessionStorage.SetItemAsync("adminId", idPart);
                    await sessionStorage.SetItemAsync("adminName", namePart);
                    await sessionStorage.SetItemAsync("adminEmail", emailPart);
                }

                navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                alertMessage = response.Message;
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"An error occurred: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
